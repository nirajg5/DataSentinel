APP_NAME=Enterprise Data Reliability Platform
APP_VERSION=1.0.0
APP_ENV=development

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=enterprise_data
DATABASE_USER=postgres
DATABASE_PASSWORD=replace_with_a_strong_password

JWT_SECRET=replace_with_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

REDIS_URL=redis://localhost:6379/0
RAG_CACHE_TTL_SECONDS=300
RAG_CACHE_VERSION=1

# Backend API Base URL (FastAPI server)
VITE_API_BASE_URL=http://localhost:8000

# Adaptive Mock Fallback (when Docker or backend dependencies are offline)
VITE_USE_MOCK_FALLBACK=true

# API request timeout (ms)
VITE_API_TIMEOUT=15000