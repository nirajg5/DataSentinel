# DataSentinel Frontend Environment Configuration

# Backend API Base URL (FastAPI backend)
VITE_API_BASE_URL=http://localhost:8000

# Fallback mode when backend / Docker is offline
# Set to 'true' to seamlessly use high-fidelity local fixtures when backend is unavailable
VITE_USE_MOCK_FALLBACK=true

# Optional timeout in milliseconds for API requests
VITE_API_TIMEOUT=15000
